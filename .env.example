# Optional confirmed production origin for canonical metadata (never set to a
# preview URL or inferred from request headers). Leave unset during local
# development and provisional scaffold previews.
# NEXT_PUBLIC_SITE_URL=https://globalfellowship.org

# Core Asymmetric.al Donor Application (`apps/donor` in `Asymmetric-al/core`)
# Handles `/checkout`, `/donor-dashboard/*`, and `/login` seamlessly.
# Local dev example: http://127.0.0.1:3005
# DONOR_APP_BASE_URL=https://give.globalfellowship.org

# Checkout handoff mode into Core's Donor Application:
# - "login" (default): routes via `/login?next=/checkout?...` matching Core's
#   authenticated `/checkout` proxy (signed-in donors 307 straight to checkout).
# - "direct": routes straight to `/checkout?...` once guest checkout is public.
# DONOR_APP_CHECKOUT_ENTRY=login

# Core Payload CMS v4 (`apps/admin` in `Asymmetric-al/core`) public read origin.
# CMS_BASE_URL=https://admin.asymmetric.al
# CMS_TENANT_ID=1
# CMS_REVALIDATE_SECRET=
