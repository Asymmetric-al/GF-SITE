{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "src/components/ui/*.tsx", "tests/**/*.spec.ts"],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "*.{ts,mts,mjs}"
  ],
  "ignoreBinaries": ["lychee", "vale"],
  "ignoreDependencies": [
    "@lhci/cli",
    "@tiptap/core",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/static-renderer",
    "lighthouse",
    "svgo",
    "tsrs"
  ]
}
