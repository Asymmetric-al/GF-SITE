{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "tests/**/*.spec.ts"],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "*.{ts,mts,mjs}"
  ],
  "ignoreBinaries": ["lychee", "vale", "ffmpeg"],
  "ignoreDependencies": [
    "@base-ui/react",
    "@hugeicons/core-free-icons",
    "@hugeicons/react",
    "@lhci/cli",
    "@tiptap/core",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/static-renderer",
    "lighthouse",
    "tsrs",
    "tw-animate-css"
  ]
}
