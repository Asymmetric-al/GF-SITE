{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo",
          "agentic-browsing"
        ],
        "preset": "desktop"
      },
      "startServerCommand": "bun run start -- --hostname 127.0.0.1 --port 3200",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/financials",
        "http://127.0.0.1:3200/give",
        "http://127.0.0.1:3200/bridge-project"
      ]
    },
    "assert": {
      "assertions": {
        "agent-accessibility-tree": [
          "error",
          { "aggregationMethod": "pessimistic", "minScore": 1 }
        ],
        "categories:accessibility": [
          "error",
          { "aggregationMethod": "pessimistic", "minScore": 1 }
        ],
        "categories:best-practices": [
          "error",
          { "aggregationMethod": "pessimistic", "minScore": 1 }
        ],
        "categories:performance": [
          "error",
          { "aggregationMethod": "median", "minScore": 0.95 }
        ],
        "categories:seo": [
          "error",
          { "aggregationMethod": "pessimistic", "minScore": 1 }
        ],
        "cumulative-layout-shift": [
          "error",
          { "aggregationMethod": "pessimistic", "maxNumericValue": 0.1 }
        ],
        "largest-contentful-paint": [
          "error",
          { "aggregationMethod": "median", "maxNumericValue": 1200 }
        ],
        "llms-txt": [
          "error",
          { "aggregationMethod": "pessimistic", "minScore": 1 }
        ],
        "total-blocking-time": [
          "error",
          { "aggregationMethod": "median", "maxNumericValue": 100 }
        ]
      }
    },
    "upload": {
      "outputDir": "artifacts/lighthouse/desktop",
      "target": "filesystem"
    }
  }
}
