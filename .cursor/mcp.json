{
  "mcpServers": {
    "next-devtools": {
      "command": "bunx",
      "args": ["next-devtools-mcp@0.4.0"]
    },
    "shadcn": {
      "command": "bunx",
      "args": ["--no-install", "shadcn", "mcp"]
    },
    "reactbits-pro": {
      "url": "https://mcp.reactbits.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${env:REACTBITS_LICENSE_KEY}"
      }
    },
    "shadcnuikit": {
      "url": "https://shadcnuikit.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SHADCNUIKIT_API_KEY}"
      }
    },
    "reui": {
      "url": "https://mcp.reui.io"
    },
    "shadcn-studio": {
      "command": "bun",
      "args": ["scripts/shadcn-studio-mcp.ts"]
    },
    "shadcn-space": {
      "url": "https://mcp.shadcnspace.com/mcp"
    }
  }
}
