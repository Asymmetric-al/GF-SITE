{
  "name": "gf-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "check": "ultracite check",
    "check:foundation": "bun scripts/check-foundation.ts",
    "okf:validate": "bun scripts/okf-validate.ts --strict",
    "okf:scan": "bun scripts/okf-scan.ts",
    "verify:brand": "bun scripts/verify-brand.ts",
    "verify:core-live": "bun scripts/verify-core-live-drill.ts",
    "fix": "ultracite fix",
    "knip": "knip",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:smoke": "playwright test --project=chromium --grep-invert @visual",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:seo": "playwright test --project=chromium --grep @seo",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "perf:lhci:mobile": "bun scripts/run-lhci.ts mobile",
    "perf:lhci:desktop": "bun scripts/run-lhci.ts desktop",
    "perf:lhci": "bun run perf:lhci:mobile && bun run perf:lhci:desktop",
    "analyze": "next analyze --output",
    "analyze:export": "next analyze export",
    "check:links": "lychee --offline README.md AGENTS.md CLAUDE.md DESIGN.md specs/README.md docs/**/*.md knowledge/**/*.md brand-kit/**/*.md",
    "check:prose": "vale README.md DESIGN.md docs knowledge brand-kit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tiptap/core": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/static-renderer": "3.35.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@interfere/landmines": "0.1.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "31.0.1",
    "knip": "6.47.0",
    "lighthouse": "13.6.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-react-doctor": "0.9.23",
    "shadcn": "4.23.0",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.1.0-beta",
    "ultracite": "8.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "sharp"
  ]
